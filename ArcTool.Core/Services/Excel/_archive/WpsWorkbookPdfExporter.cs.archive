using System;
using System.Collections.Generic;
using System.IO;
using System.Reflection;
using System.Runtime.InteropServices;

namespace ArcTool.Core.Services.Excel
{
    /// <summary>
    /// WPS Spreadsheet provider for <see cref="ISpreadsheetPdfExporter"/>.
    ///
    /// This file is late-bound BY DESIGN and must stay that way. It reaches COM exclusively
    /// through <see cref="Type.GetTypeFromProgID(string, bool)"/> +
    /// <see cref="Activator.CreateInstance(Type)"/> + <see cref="Type.InvokeMember"/>. It must never
    /// reference the early-bound Excel Interop assembly (Microsoft's Office Excel automation
    /// library), any early-bound Excel enum, or any early-bound COM type — including local
    /// variable declarations. A future reader must not "clean this up" into
    /// early binding; that would defeat the entire reason this file exists (running on machines that
    /// have WPS but not MS Excel). See the ArcTool "excel-to-revit-wps-provider-split" work package,
    /// tasks T1.2/T3.2, for the locked design this file implements verbatim.
    ///
    /// WPS behavior is UNVERIFIED pending operator-run evidence EV-1 (ProgID + member probe) and
    /// EV-2 (end-to-end export + PDF fidelity). Every WPS-specific claim below is an ASSUMPTION
    /// carried from T1.2, not a confirmed fact. Do not add, remove, or reorder ProgID candidates or
    /// call shapes without re-checking that evidence first.
    ///
    /// Numeric constant provenance (T1.2 §3): all four values are sourced from the Microsoft Learn
    /// Excel VBA reference (the enums exist only in the Excel object model); whether WPS's
    /// <c>ExportAsFixedFormat</c> / <c>PaperSize</c> accept the same integers with the same effect is
    /// explicitly unproven and is exactly what EV-1/EV-2 exist to test.
    /// </summary>
    public sealed class WpsWorkbookPdfExporter : ISpreadsheetPdfExporter
    {
        // ── ProgID fallback chain (T1.2 §1) ────────────────────────────────────────────────
        // Order matters: KET.Application is the only candidate confirmed to resolve on the
        // development machine (WPS Office 12.1.0.28032, per-user/HKCU registration only). The
        // other two are kept only because other WPS builds may register under those names; both
        // remain unverified everywhere.
        private const string ProgIdKet         = "KET.Application";
        private const string ProgIdEt          = "ET.Application";
        private const string ProgIdKingsoftEt  = "Kingsoft.ET.Application";

        private static readonly string[] ProgIdCandidates = { ProgIdKet, ProgIdEt, ProgIdKingsoftEt };

        // DO NOT add the Writer application's ProgID to this list, ever, under any fallback
        // rationale. It resolves and instantiates on this machine, but it is the document editor,
        // not the spreadsheet app: it would pass ProgID probing and produce a live COM object with
        // no spreadsheet members, turning a clean "engine absent" outcome into a deep
        // MissingMemberException inside Open()/ExportRegionToPdf(). Reject by name, not by probing
        // after the fact.

        // ── Spreadsheet-model numeric constants (T1.2 §3) — sourced from the legacy single-
        //    provider implementation's object-model contract, ASSUMPTION for WPS ────────────────
        private const int FixedFormatTypePdfValue         = 0;  // fixed-format-type "PDF" member value
        private const int FixedFormatQualityStandardValue = 0;  // fixed-format-quality "standard" member value
        private const int PaperSizeEsheetValue            = 26; // paper-size "Esheet" member value
        private const int PaperSizeA3Value                = 8;  // paper-size "A3" member value (tolerable fallback only)

        private const BindingFlags PublicInstance = BindingFlags.Public | BindingFlags.Instance;

        private object _app;
        private object _workbook;
        private bool _disposed;

        public SpreadsheetEngine Engine => SpreadsheetEngine.Wps;

        // ── Late-binding helpers — the only way this file may touch COM ───────────────────
        private static object GetProp(object target, string name, params object[] args)
            => target.GetType().InvokeMember(name, BindingFlags.GetProperty | PublicInstance, null, target, args);

        private static bool TryGetProp(object target, string name, out object value)
        {
            value = null;
            if (target == null) return false;

            try
            {
                value = GetProp(target, name);
                return value != null;
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine(
                    $"WpsWorkbookPdfExporter: property '{name}' bind failed: {ex.Message}");
                return false;
            }
        }

        private static void SetProp(object target, string name, object value)
            => target.GetType().InvokeMember(name, BindingFlags.SetProperty | PublicInstance, null, target, new object[] { value });

        private static object CallMethod(object target, string name, params object[] args)
            => target.GetType().InvokeMember(name, BindingFlags.InvokeMethod | PublicInstance, null, target, args);

        private static object[] CreateWorkbookOpenArgs(string filePath, int parameterCount)
        {
            var args = new object[parameterCount];
            args[0] = filePath;
            for (int i = 1; i < args.Length; i++)
                args[i] = Type.Missing;

            return args;
        }

        private static object TryGetWorkbookFromWindow(object activeWindow)
        {
            if (activeWindow == null) return null;

            try
            {
                var workbook = GetProp(activeWindow, "Workbook");
                if (workbook != null)
                    return workbook;

                System.Diagnostics.Debug.WriteLine(
                    "WpsWorkbookPdfExporter.Open: ActiveWindow.Workbook returned null.");
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine(
                    $"WpsWorkbookPdfExporter.Open: ActiveWindow.Workbook unavailable: {ex.Message}");
            }

            return null;
        }

        private static object TryOpenWorkbook(object workbooks, string filePath)
        {
            if (workbooks == null)
            {
                System.Diagnostics.Debug.WriteLine(
                    "WpsWorkbookPdfExporter.Open: Workbooks surface is null.");
                return null;
            }

            object[][] attempts =
            {
                CreateWorkbookOpenArgs(filePath, 15),
                CreateWorkbookOpenArgs(filePath, 13)
            };

            string[] memberNames = { "Open", "_Open" };

            for (int i = 0; i < attempts.Length; i++)
            {
                try
                {
                    var workbook = CallMethod(workbooks, memberNames[i], attempts[i]);
                    if (workbook != null)
                        return workbook;

                    System.Diagnostics.Debug.WriteLine(
                        $"WpsWorkbookPdfExporter.Open: Workbooks.{memberNames[i]} returned null.");
                }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine(
                        $"WpsWorkbookPdfExporter.Open: Workbooks.{memberNames[i]} failed: {ex.Message}");
                }
            }

            return null;
        }

        private static object AcquireWorkbookSurface(object app, string filePath, out object workbooks)
        {
            workbooks = null;

            if (TryGetProp(app, "ActiveWorkbook", out var activeWorkbook))
                return activeWorkbook;

            if (TryGetProp(app, "ActiveWindow", out var activeWindow))
            {
                try
                {
                    var windowWorkbook = TryGetWorkbookFromWindow(activeWindow);
                    if (windowWorkbook != null)
                        return windowWorkbook;
                }
                finally
                {
                    Marshal.ReleaseComObject(activeWindow);
                }
            }
            else
            {
                System.Diagnostics.Debug.WriteLine(
                    "WpsWorkbookPdfExporter.Open: ActiveWindow surface unavailable or null.");
            }

            if (!TryGetProp(app, "Workbooks", out var workbookCollection))
            {
                System.Diagnostics.Debug.WriteLine(
                    "WpsWorkbookPdfExporter.Open: Workbooks surface unavailable or null.");
                return null;
            }

            workbooks = workbookCollection;
            return TryOpenWorkbook(workbookCollection, filePath);
        }

        /// <summary>
        /// Probes the ProgID chain, activates the first viable candidate, and opens
        /// <paramref name="filePath"/>. Never throws; any failure is swallowed and reported by
        /// returning <c>false</c>, mirroring the MS provider's <c>Open</c> contract exactly.
        /// </summary>
        public bool Open(string filePath)
        {
            object app = null;
            Exception lastError = null;

            foreach (var progId in ProgIdCandidates)
            {
                Type t;
                try { t = Type.GetTypeFromProgID(progId, throwOnError: false); }
                catch (Exception ex) { lastError = ex; continue; }

                if (t == null) continue; // not registered for this user — not an error, just absent

                object candidate;
                try
                {
                    candidate = Activator.CreateInstance(t);
                }
                catch (Exception ex) // COMException expected for a stale/broken registration
                {
                    lastError = ex;
                    System.Diagnostics.Debug.WriteLine(
                        $"WpsWorkbookPdfExporter.Open: '{progId}' resolved but activation failed: {ex.Message}");
                    continue;
                }

                try
                {
                    // Viability smoke test (T1.2 §1 step 4): a COM object that rejects these two
                    // baseline property sets will not survive Workbooks.Open either.
                    SetProp(candidate, "Visible", false);
                    SetProp(candidate, "DisplayAlerts", false);
                }
                catch (Exception ex)
                {
                    lastError = ex;
                    System.Diagnostics.Debug.WriteLine(
                        $"WpsWorkbookPdfExporter.Open: '{progId}' failed viability smoke test: {ex.Message}");
                    Marshal.ReleaseComObject(candidate);
                    continue;
                }

                app = candidate;
                System.Diagnostics.Debug.WriteLine($"WpsWorkbookPdfExporter.Open: using '{progId}'.");
                break;
            }

            if (app == null)
            {
                // EngineAbsent — nothing to fall back to.
                System.Diagnostics.Debug.WriteLine(
                    "WpsWorkbookPdfExporter.Open: EngineAbsent" +
                    (lastError != null ? $" (last error: {lastError.Message})" : " (no WPS ProgID registered for this user)"));
                return false;
            }

            // Keep _app even if the Open below fails: the engine is live, and Dispose() still
            // needs to Quit() it. Only EngineAbsent leaves _app null.
            _app = app;

            object workbooks = null;
            try
            {
                var workbook = AcquireWorkbookSurface(_app, filePath, out workbooks);
                if (workbook == null)
                {
                    System.Diagnostics.Debug.WriteLine(
                        "WpsWorkbookPdfExporter.Open: EngineFoundOpenFailed (no usable workbook surface from ActiveWorkbook, ActiveWindow, or Workbooks)."
                    );
                    return false;
                }

                _workbook = workbook;
                return true;
            }
            catch (Exception ex)
            {
                // EngineFoundOpenFailed — engine is live, this file/path failed.
                System.Diagnostics.Debug.WriteLine($"WpsWorkbookPdfExporter.Open: EngineFoundOpenFailed: {ex.Message}");
                return false;
            }
            finally
            {
                // Short-lived intermediate (T1.2 §5) — release right after Open returns.
                if (workbooks != null) Marshal.ReleaseComObject(workbooks);
            }
        }

        /// <summary>
        /// Enumerates worksheet names via Worksheets.Count/Item (the same collection-walk
        /// mechanism locked for Worksheets in T1.2 §2 rows 5-8). Never throws, never returns
        /// null.
        /// </summary>
        public IReadOnlyList<string> GetSheetNames()
        {
            var result = new List<string>();
            if (_workbook == null) return result;

            object worksheets = null;
            try
            {
                worksheets = GetProp(_workbook, "Worksheets");

                int count;
                try { count = Convert.ToInt32(GetProp(worksheets, "Count")); }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine($"WpsWorkbookPdfExporter.GetSheetNames: cannot enumerate — {ex.Message}");
                    return result;
                }

                for (int i = 1; i <= count; i++)
                {
                    object worksheet = null;
                    try
                    {
                        worksheet = GetProp(worksheets, "Item", i);
                        if (worksheet == null) continue;
                        var name = GetProp(worksheet, "Name");
                        if (name != null) result.Add(name.ToString());
                    }
                    catch (Exception ex)
                    {
                        System.Diagnostics.Debug.WriteLine($"WpsWorkbookPdfExporter.GetSheetNames: skipped sheet #{i} — {ex.Message}");
                    }
                    finally
                    {
                        if (worksheet != null) Marshal.ReleaseComObject(worksheet);
                    }
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"WpsWorkbookPdfExporter.GetSheetNames: {ex.Message}");
            }
            finally
            {
                if (worksheets != null) Marshal.ReleaseComObject(worksheets);
            }

            return result;
        }

        /// <summary>
        /// Enumerates named ranges scoped to <paramref name="sheetName"/> via
        /// Names.Count/Item + Name/RefersToRange/Worksheet (T1.2 §2 rows 9-13). Never throws,
        /// never returns null.
        /// </summary>
        public IReadOnlyList<string> GetNamedRanges(string sheetName)
        {
            var result = new List<string>();
            if (_workbook == null || string.IsNullOrWhiteSpace(sheetName)) return result;

            object names = null;
            try
            {
                names = GetProp(_workbook, "Names");

                int count;
                try { count = Convert.ToInt32(GetProp(names, "Count")); }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine($"WpsWorkbookPdfExporter.GetNamedRanges: cannot enumerate — {ex.Message}");
                    return result;
                }

                for (int i = 1; i <= count; i++)
                {
                    object nameObj = null;
                    object range = null;
                    object rangeWorksheet = null;
                    try
                    {
                        nameObj = GetProp(names, "Item", i);
                        if (nameObj == null) continue;

                        string nmName;
                        try { nmName = GetProp(nameObj, "Name")?.ToString(); }
                        catch { continue; } // skip that entry

                        try { range = GetProp(nameObj, "RefersToRange"); }
                        catch { continue; } // per-item try/catch, mirrors MS provider
                        if (range == null) continue;

                        try { rangeWorksheet = GetProp(range, "Worksheet"); }
                        catch { continue; }

                        string wsName;
                        try { wsName = GetProp(rangeWorksheet, "Name")?.ToString(); }
                        catch { continue; }

                        if (!string.IsNullOrEmpty(nmName) &&
                            string.Equals(wsName, sheetName, StringComparison.OrdinalIgnoreCase))
                        {
                            result.Add(nmName);
                        }
                    }
                    catch (Exception ex)
                    {
                        System.Diagnostics.Debug.WriteLine($"WpsWorkbookPdfExporter.GetNamedRanges: skipped entry #{i} — {ex.Message}");
                    }
                    finally
                    {
                        if (rangeWorksheet != null) Marshal.ReleaseComObject(rangeWorksheet);
                        if (range != null) Marshal.ReleaseComObject(range);
                        if (nameObj != null) Marshal.ReleaseComObject(nameObj);
                    }
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"WpsWorkbookPdfExporter.GetNamedRanges: {ex.Message}");
            }
            finally
            {
                if (names != null) Marshal.ReleaseComObject(names);
            }

            return result;
        }

        /// <summary>
        /// Resolves the printable region (NamedRange → PrintArea → UsedRange), normalizes
        /// PageSetup, and exports to <paramref name="outputPdfPath"/>. Never throws. Verifies the
        /// PDF actually exists on disk before reporting success (T1.2 §4 — no MS-provider
        /// precedent, WPS-specific).
        /// </summary>
        public bool ExportRegionToPdf(string sheetName, string regionName, string outputPdfPath)
        {
            if (_workbook == null || string.IsNullOrWhiteSpace(sheetName)) return false;

            object worksheet = null;
            object targetRange = null;
            object pageSetup;

            try
            {
                object worksheets = null;
                try
                {
                    worksheets = GetProp(_workbook, "Worksheets");
                    try
                    {
                        worksheet = GetProp(worksheets, "Item", sheetName);
                    }
                    catch (Exception ex)
                    {
                        System.Diagnostics.Debug.WriteLine(
                            $"WpsWorkbookPdfExporter.ExportRegionToPdf: EngineFoundExportFailed (sheet '{sheetName}' not found): {ex.Message}");
                        return false;
                    }
                }
                finally
                {
                    if (worksheets != null) Marshal.ReleaseComObject(worksheets);
                }

                if (worksheet == null)
                {
                    System.Diagnostics.Debug.WriteLine(
                        $"WpsWorkbookPdfExporter.ExportRegionToPdf: EngineFoundExportFailed (sheet '{sheetName}' not found).");
                    return false;
                }

                try
                {
                    pageSetup = GetProp(worksheet, "PageSetup");
                }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine(
                        $"WpsWorkbookPdfExporter.ExportRegionToPdf: EngineFoundExportFailed (PageSetup unavailable): {ex.Message}");
                    return false;
                }

                // Region resolution stays named-region → PrintArea → UsedRange. pageSetup is
                // fetched once above and reused for both the PrintArea read here and the
                // normalization below — deliberately avoiding the chained
                // `worksheet.PageSetup.PrintArea` shape, which would leave an untracked
                // intermediate RCW (T1.2 §5 no-chaining rule).
                if (!string.IsNullOrWhiteSpace(regionName))
                {
                    try { targetRange = GetProp(worksheet, "Range", regionName); }
                    catch (Exception ex)
                    {
                        System.Diagnostics.Debug.WriteLine(
                            $"WpsWorkbookPdfExporter.ExportRegionToPdf: named range '{regionName}' not found on '{sheetName}', falling back: {ex.Message}");
                    }
                }

                if (targetRange == null)
                {
                    try
                    {
                        var printArea = GetProp(pageSetup, "PrintArea") as string;
                        if (!string.IsNullOrEmpty(printArea))
                            targetRange = GetProp(worksheet, "Range", printArea);
                    }
                    catch (Exception ex)
                    {
                        System.Diagnostics.Debug.WriteLine(
                            $"WpsWorkbookPdfExporter.ExportRegionToPdf: print area unreadable on '{sheetName}', falling back to used range: {ex.Message}");
                    }
                }

                if (targetRange == null)
                {
                    try
                    {
                        targetRange = GetProp(worksheet, "UsedRange");
                    }
                    catch (Exception ex)
                    {
                        // Last fallback — throwing here means no range at all; export fails.
                        System.Diagnostics.Debug.WriteLine(
                            $"WpsWorkbookPdfExporter.ExportRegionToPdf: EngineFoundExportFailed (no usable range on '{sheetName}'): {ex.Message}");
                        return false;
                    }
                }

                if (targetRange == null) return false;

                // Range.Address(RowAbsolute:=false, ColumnAbsolute:=false) — parameterized
                // property (T1.2 §2 row 17). WPS's exact IDispatch dispatch shape for this call is
                // UNVERIFIED; fall back to the no-arg form (default absolute address) if the
                // parameterized call throws. Do not guess a combined GetProperty|InvokeMethod flag
                // — EV-1 must confirm the minimal working combination before this is changed.
                string address;
                try
                {
                    address = GetProp(targetRange, "Address", false, false) as string;
                }
                catch (Exception ex1)
                {
                    System.Diagnostics.Debug.WriteLine(
                        $"WpsWorkbookPdfExporter.ExportRegionToPdf: Address(false,false) failed, retrying no-arg form: {ex1.Message}");
                    try
                    {
                        address = GetProp(targetRange, "Address") as string;
                    }
                    catch (Exception ex2)
                    {
                        System.Diagnostics.Debug.WriteLine(
                            $"WpsWorkbookPdfExporter.ExportRegionToPdf: EngineFoundExportFailed (Range.Address unavailable): {ex2.Message}");
                        return false;
                    }
                }

                if (string.IsNullOrEmpty(address))
                {
                    System.Diagnostics.Debug.WriteLine(
                        "WpsWorkbookPdfExporter.ExportRegionToPdf: EngineFoundExportFailed (Range.Address returned empty).");
                    return false;
                }

                try
                {
                    SetProp(pageSetup, "PrintArea", address);
                    SetProp(pageSetup, "Zoom", false);
                    SetProp(pageSetup, "FitToPagesWide", 1);
                    SetProp(pageSetup, "FitToPagesTall", 1);
                    SetProp(pageSetup, "TopMargin", 0.0);
                    SetProp(pageSetup, "BottomMargin", 0.0);
                    SetProp(pageSetup, "LeftMargin", 0.0);
                    SetProp(pageSetup, "RightMargin", 0.0);
                }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine(
                        $"WpsWorkbookPdfExporter.ExportRegionToPdf: EngineFoundExportFailed (page setup normalization): {ex.Message}");
                    return false;
                }

                // PaperSize — the sole tolerable-by-design property (T1.2 §2 row 24): use the
                // primary paper-size constant first, then the fallback paper-size constant, then
                // silently keep whatever is current.
                try { SetProp(pageSetup, "PaperSize", PaperSizeEsheetValue); }
                catch
                {
                    try { SetProp(pageSetup, "PaperSize", PaperSizeA3Value); }
                    catch { /* keep current paper size — FitToPages still handles it */ }
                }

                try
                {
                    CallMethod(worksheet, "ExportAsFixedFormat",
                        FixedFormatTypePdfValue, outputPdfPath, FixedFormatQualityStandardValue, false, false, 1, 1, false);
                }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine(
                        $"WpsWorkbookPdfExporter.ExportRegionToPdf: EngineFoundExportFailed (PDF export unsupported on this WPS build): {ex.Message}");
                    return false;
                }

                // WPS may return without throwing and without producing a file — no MS-provider
                // precedent for this check (T1.2 §4); required because "wps.exe /prometheus /et
                // /Automation" runs the spreadsheet as a shell mode rather than a dedicated server.
                if (!File.Exists(outputPdfPath))
                {
                    System.Diagnostics.Debug.WriteLine(
                        "WpsWorkbookPdfExporter.ExportRegionToPdf: EngineFoundExportFailed (no output produced).");
                    return false;
                }

                return true;
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"WpsWorkbookPdfExporter.ExportRegionToPdf: {ex.Message}");
                return false;
            }
            finally
            {
                // Release targetRange before worksheet. pageSetup is deliberately NOT released
                // here — the reference implementation's finally block does not release it either.
                if (targetRange != null) Marshal.ReleaseComObject(targetRange);
                if (worksheet != null) Marshal.ReleaseComObject(worksheet);
            }
        }

        /// <summary>
        /// Closes the workbook and quits the WPS host, child before parent. Must never throw.
        /// </summary>
        public void Dispose()
        {
            if (_disposed) return;
            _disposed = true;

            if (_workbook != null)
            {
                try { CallMethod(_workbook, "Close", false); }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine($"WpsWorkbookPdfExporter.Dispose: Close failed (ignored): {ex.Message}");
                }
                finally
                {
                    try { Marshal.ReleaseComObject(_workbook); } catch { /* Dispose must not throw */ }
                    _workbook = null;
                }
            }

            if (_app != null)
            {
                try { CallMethod(_app, "Quit"); }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine($"WpsWorkbookPdfExporter.Dispose: Quit failed (ignored): {ex.Message}");
                }
                finally
                {
                    try { Marshal.ReleaseComObject(_app); } catch { /* Dispose must not throw */ }
                    _app = null;
                }
            }
        }
    }
}
