<Window x:Class="ArcTool.UI.CoordSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArcTool — Coordinate Settings"
        Width="440"
        Height="245"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0"
               Grid.Column="0"
               Content="Axis Mapping"
               HorizontalContentAlignment="Right"
               VerticalAlignment="Center"
               Padding="0,0,8,0"/>
        <ComboBox x:Name="AxisMappingComboBox"
                  Grid.Row="0"
                  Grid.Column="1"
                  Margin="0,0,0,10"
                  VerticalAlignment="Center"
                  IsEditable="False"/>

        <Label Grid.Row="1"
               Grid.Column="0"
               Content="Output Unit"
               HorizontalContentAlignment="Right"
               VerticalAlignment="Center"
               Padding="0,0,8,0"/>
        <ComboBox x:Name="OutputUnitComboBox"
                  Grid.Row="1"
                  Grid.Column="1"
                  Margin="0,0,0,10"
                  VerticalAlignment="Center"
                  IsEditable="False"/>

        <Label Grid.Row="2"
               Grid.Column="0"
               Content="Trigger Filter"
               HorizontalContentAlignment="Right"
               VerticalAlignment="Center"
               Padding="0,0,8,0"/>
        <ComboBox x:Name="TriggerFilterComboBox"
                  Grid.Row="2"
                  Grid.Column="1"
                  Margin="0,0,0,10"
                  VerticalAlignment="Center"
                  IsEditable="False"
                  ToolTip="Only categories with validated extraction and writeback rules are shown. Additional categories will appear in future versions."/>

        <StackPanel Grid.Row="4"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="80"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
            <Button Content="OK"
                    Width="80"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
